# Copy this file to .env and fill in your key from https://aistudio.google.com/apikey
# The key is only read by the Vite server (server/aiDesign.ts); it is never sent to the browser.
GEMINI_API_KEY=
# Optional: Gemini model ids. The fallback is used when the main model is overloaded or slow.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
